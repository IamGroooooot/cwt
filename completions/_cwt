#compdef cwt
# ─────────────────────────────────────────────────────────────────────────────
# Zsh completion for cwt - AI Worktree Manager
# ─────────────────────────────────────────────────────────────────────────────

typeset -g _cwt_completion_file="${${(%):-%N}:A}"
typeset -g _cwt_completion_root="${_cwt_completion_file:h:h}"

(( $+functions[_cwt_completion_ensure_shared_helpers] )) || _cwt_completion_ensure_shared_helpers() {
  (( $+functions[_cwt_load_project_config] )) && (( $+functions[_cwt_resolve_worktrees_dir] )) && \
    (( $+functions[_cwt_collect_managed_worktrees] )) && return 0

  local cwt_sh="${_cwt_completion_root}/cwt.sh"
  [[ -f "$cwt_sh" ]] || return 1
  source "$cwt_sh"
}

# Resolve the shared repository root (works in linked worktrees too).
(( $+functions[_cwt_repo_root] )) || _cwt_repo_root() {
  local current_root git_common_dir
  current_root=$(git rev-parse --show-toplevel 2>/dev/null) || return

  git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null)
  if [[ -z "$git_common_dir" ]]; then
    echo "${current_root:A}"
    return
  fi

  if [[ "$git_common_dir" != /* ]]; then
    git_common_dir="${current_root}/${git_common_dir}"
  fi
  echo "${git_common_dir:A:h}"
}

(( $+functions[_cwt_completion_prepare_context] )) || _cwt_completion_prepare_context() {
  local git_root
  git_root=$(_cwt_repo_root) || return 1
  _cwt_completion_ensure_shared_helpers || return 1

  _cwt_load_config
  typeset -g _cwt_git_root="$git_root"
  _cwt_load_project_config
}

(( $+functions[_cwt_project_worktree_dir] )) || _cwt_project_worktree_dir() {
  _cwt_completion_prepare_context || return 1
  [[ -n "$CWT_WORKTREE_DIR" ]] && print -r -- "$CWT_WORKTREE_DIR" && return 0
  [[ -n "$_cwt_config_current_project_worktree_dir" ]] && print -r -- "$_cwt_config_current_project_worktree_dir" && return 0
  return 1
}

# Resolve configured worktree dir relative to the main repo root.
(( $+functions[_cwt_resolve_worktree_dir] )) || _cwt_resolve_worktree_dir() {
  _cwt_completion_prepare_context || return 1
  _cwt_resolve_worktrees_dir
}

# List existing cwt-managed worktree names.
(( $+functions[_cwt_worktree_names] )) || _cwt_worktree_names() {
  local git_root worktrees_dir
  _cwt_completion_prepare_context || return

  git_root="$_cwt_git_root"
  worktrees_dir=$(_cwt_resolve_worktrees_dir) || return
  [[ -d "$worktrees_dir" ]] || return

  local -a names
  _cwt_collect_managed_worktrees "$git_root" "$worktrees_dir"
  names=("${_cwt_worktree_names_cache[@]}")

  if (( ${#names} > 1 )); then
    names=(${(on)names})
  fi
  (( ${#names} )) && compadd -Q -X "worktrees" -a names
}

# List git branch names
(( $+functions[_cwt_branches] )) || _cwt_branches() {
  local git_root
  git_root=$(_cwt_repo_root) || return

  local -a branches
  branches=( ${(f)"$(git -C "$git_root" branch --format='%(refname:short)' 2>/dev/null)"} )
  (( ${#branches} )) && compadd -X "branches" -a branches
}

(( $+functions[_cwt_assistants] )) || _cwt_assistants() {
  compadd -X "assistants" claude codex gemini
}

(( $+functions[_cwt_launch_targets] )) || _cwt_launch_targets() {
  compadd -X "launch targets" current split tab
}

_cwt_complete_new() {
  _arguments -s \
    '(-h --help)'{-h,--help}'[Show help]' \
    '--assistant[Assistant to launch]:assistant:_cwt_assistants' \
    '--claude[Shortcut for --assistant claude]' \
    '--codex[Shortcut for --assistant codex]' \
    '--gemini[Shortcut for --assistant gemini]' \
    '--launch-target[Assistant launch target]:target:_cwt_launch_targets' \
    '--current[Shortcut for --launch-target current]' \
    '--split[Shortcut for --launch-target split]' \
    '--tab[Shortcut for --launch-target tab]' \
    '--all-permissions[Launch with full permissions for supported assistants]' \
    '--default-permissions[Use assistant default permission mode]' \
    '--yolo[Shortcut for --assistant codex --all-permissions]' \
    '--dangerously-skip-permissions[Shortcut for --assistant claude --all-permissions]' \
    '--no-launch[Skip assistant launch after creation]' \
    ':name:' \
    ':base-branch:_cwt_branches' \
    ':branch-name:'
}

_cwt_complete_ls() {
  _arguments -s \
    '(-h --help)'{-h,--help}'[Show help]'
}

_cwt_complete_cd() {
  _arguments -s \
    '(-h --help)'{-h,--help}'[Show help]' \
    '--assistant[Assistant to launch]:assistant:_cwt_assistants' \
    '--claude[Shortcut for --assistant claude]' \
    '--codex[Shortcut for --assistant codex]' \
    '--gemini[Shortcut for --assistant gemini]' \
    '--launch-target[Assistant launch target]:target:_cwt_launch_targets' \
    '--current[Shortcut for --launch-target current]' \
    '--split[Shortcut for --launch-target split]' \
    '--tab[Shortcut for --launch-target tab]' \
    '--all-permissions[Launch with full permissions for supported assistants]' \
    '--default-permissions[Use assistant default permission mode]' \
    '--yolo[Shortcut for --assistant codex --all-permissions]' \
    '--dangerously-skip-permissions[Shortcut for --assistant claude --all-permissions]' \
    ':name:_cwt_worktree_names'
}

_cwt_complete_rm() {
  _arguments -s \
    '(-h --help)'{-h,--help}'[Show help]' \
    '(-f --force)'{-f,--force}'[Skip confirmation prompt]' \
    ':name:_cwt_worktree_names'
}

_cwt_complete_update() {
  _arguments -s \
    '(-h --help)'{-h,--help}'[Show help]'
}

_cwt() {
  local -a commands
  commands=(
    'new:Create a new worktree and launch an assistant'
    'ls:List all worktrees with status'
    'cd:Enter an existing worktree'
    'rm:Remove a worktree'
    'update:Self-update cwt'
  )

  _arguments -s \
    '(-q --quiet)'{-q,--quiet}'[Suppress informational messages]' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '(-v --version)'{-v,--version}'[Show version]' \
    '1:command:->command' \
    '*::args:->args'

  case "$state" in
    command)
      _describe -t commands 'cwt command' commands
      ;;
    args)
      case "$words[1]" in
        new)    _cwt_complete_new    ;;
        ls)     _cwt_complete_ls     ;;
        cd)     _cwt_complete_cd     ;;
        rm)     _cwt_complete_rm     ;;
        update) _cwt_complete_update ;;
      esac
      ;;
  esac
}
